#!/usr/bin/env bash
set -euo pipefail
deploy_dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/casbot-runtime-env
source "$deploy_dir/lib/casbot-runtime-env"
casbot_source_runtime "$@"
export PYTHONPATH="$deploy_dir/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "$CASBOT_DEPLOY_PYTHON" -c 'from casbot_deploy.cli import switch_main; raise SystemExit(switch_main())' "$@"
